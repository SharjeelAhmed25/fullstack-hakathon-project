PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hcm_lite
# Optional local source URI for the one-time `npm run migrate:atlas` command.
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
JWT_SECRET=generate-a-private-random-secret
OFFICE_TIME_ZONE=Asia/Karachi
# Optional OpenAI-compatible provider settings for model-powered assistant responses.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
